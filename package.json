{
  "name": "job-sniper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OpenClaw-native job intelligence skill for role discovery, company research, and public-contact outreach workflows.",
  "scripts": {
    "sniper": "node --import tsx ./scripts/run-sniper.mjs",
    "build:runtime": "tsc -p tsconfig.runtime.json",
    "dashboard:export": "npx tsx ./scripts/export-dashboard-data.ts",
    "live:sync": "node ./scripts/sync-live-state.mjs",
    "sync:state": "npm run dashboard:export && npm run sniper -- sheet sync",
    "pretest": "node ./scripts/repair-vitest.mjs",
    "test": "vitest run test/*.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "format": "prettier --check src/ test/",
    "format:fix": "prettier --write src/ test/"
  },
  "dependencies": {
    "@vitest/utils": "^3.2.4",
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.1.2",
    "fast-xml-parser": "^5.3.0",
    "googleapis": "^157.0.0",
    "pdf-parse": "^1.1.1",
    "playwright-core": "^1.58.2",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.6.0",
    "@vitest/runner": "^4.0.8",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.0.8"
  }
}
