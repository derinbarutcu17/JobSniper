{
  "name": "job-sniper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OpenClaw-native job intelligence skill for role discovery, company research, and public-contact outreach workflows.",
  "scripts": {
    "sniper": "node ./scripts/run-sniper.mjs",
    "build:runtime": "tsc -p tsconfig.runtime.json",
    "dashboard:export": "npx tsx ./scripts/export-dashboard-data.ts",
    "sync:state": "npm run dashboard:export && npm run sniper -- sheet sync",
    "pretest": "node ./scripts/repair-vitest.mjs",
    "test": "vitest run test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vitest/utils": "^3.2.4",
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.1.2",
    "fast-xml-parser": "^5.3.0",
    "googleapis": "^157.0.0",
    "pdf-parse": "^1.1.1",
    "playwright-core": "^1.58.2",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.6.0",
    "@vitest/runner": "^4.0.8",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
