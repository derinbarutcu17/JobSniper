# Job Sniper Environment Configuration
# Copy this file to .env and fill in your values.

# Google Sheets API — provide one of:
# SNIPER_GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# SNIPER_GOOGLE_SERVICE_ACCOUNT_PATH=/path/to/service-account.json
SNIPER_GOOGLE_SERVICE_ACCOUNT_JSON=
SNIPER_GOOGLE_SERVICE_ACCOUNT_PATH=

# Google Sheets identifiers
SNIPER_GOOGLE_SHEET_ID=
SNIPER_GOOGLE_FOLDER_ID=

# Optional: override default tab names (defaults: Jobs, Companies, Contacts, RunMetrics)
# SNIPER_JOBS_TAB=Jobs
# SNIPER_COMPANIES_TAB=Companies
# SNIPER_CONTACTS_TAB=Contacts
# SNIPER_RUN_METRICS_TAB=RunMetrics
# SNIPER_DAILY_JOBS_PREFIX=Jobs_

# Set to "1" to enable Sheet pull from remote
# SNIPER_ENABLE_SHEET_PULL=1

# Set to "1" to enable Gmail connector for tomorrow sourcing
# SNIPER_GMAIL_CONNECTOR_AVAILABLE=1

# Override the base directory (defaults to repo root)
# SNIPER_BASE_DIR=/path/to/job-sniper

# Custom Chrome/Chromium path for headless browser
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
